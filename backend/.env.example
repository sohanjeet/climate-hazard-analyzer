# Local MongoDB, or a MongoDB Atlas SRV string such as:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Never commit the real value; keep it in .env only.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=climate_hazard_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Browser origins allowed to call the API (comma-separated, no trailing slash needed).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Per client IP, per minute. /api/heatwaves has its own, stricter bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_HEATWAVE_REQUESTS_PER_MINUTE=20
# Set true only behind a reverse proxy you control; X-Forwarded-For is otherwise client-controlled.
TRUST_PROXY_HEADERS=false

# Open-Meteo: simultaneous requests (process-wide), retries for transient failures only.
WEATHER_FETCH_CONCURRENCY=4
OPEN_METEO_TIMEOUT_SECONDS=10
OPEN_METEO_MAX_RETRIES=2
LOG_LEVEL=INFO
